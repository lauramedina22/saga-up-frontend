{
  "database_name": "SAGA-UP",
  "description": "Diccionario de datos del modelo SAGA-UP",
  "tables": [
    {
      "name": "children",
      "description": "Registro principal de cada niño o niña atendido por la fundación.",
      "columns": [
        { "name": "child_id", "type": "bigint", "key": "PK", "description": "Identificador único del niño" },
        { "name": "first_name", "type": "text", "description": "Nombres" },
        { "name": "last_name", "type": "text", "description": "Apellidos" },
        { "name": "birth_date", "type": "date", "description": "Fecha de nacimiento" },
        { "name": "sex", "type": "smallint", "description": "Sexo del niño" },
        { "name": "document_type", "type": "smallint", "description": "Tipo de documento de identidad" },
        { "name": "document_number", "type": "text", "description": "Número de documento de identidad" },
        { "name": "admission_date", "type": "date", "description": "Fecha de ingreso a la fundación" },
        { "name": "exit_date", "type": "date", "description": "Fecha de retiro de la fundación" },
        { "name": "status_id", "type": "smallint", "description": "Estado del niño dentro de la fundación" },
        { "name": "notes", "type": "text", "description": "Observaciones generales" }
      ]
    },
    {
      "name": "guardians",
      "description": "Personas responsables legalmente de los niños.",
      "columns": [
        { "name": "guardian_id", "type": "bigint", "key": "PK", "description": "Identificador único del acudiente" },
        { "name": "full_name", "type": "text", "description": "Nombre completo" },
        { "name": "document_type", "type": "text", "description": "Tipo de documento de identidad" },
        { "name": "document_number", "type": "text", "description": "Número de documento de identidad" },
        { "name": "phone", "type": "text", "description": "Teléfono de contacto" },
        { "name": "address", "type": "text", "description": "Dirección de residencia" },
        { "name": "legal_status", "type": "text", "description": "Situación jurídica del acudiente frente al niño" }
      ]
    },
    {
      "name": "children_guardians",
      "description": "Tabla intermedia que relaciona niños con sus acudientes.",
      "columns": [
        { "name": "child_guardian_id", "type": "bigint", "key": "PK", "description": "Identificador único de la relación" },
        { "name": "child_id", "type": "bigint", "key": "FK", "references": "children", "description": "Niño de la relación" },
        { "name": "guardian_id", "type": "bigint", "key": "FK", "references": "guardians", "description": "Acudiente de la relación" },
        { "name": "guardianship_type", "type": "text", "description": "Tipo de custodia o vínculo legal" },
        { "name": "start_date", "type": "date", "description": "Fecha de inicio de la relación" },
        { "name": "end_date", "type": "date", "description": "Fecha de fin de la relación" }
      ]
    },
    {
      "name": "child_records",
      "description": "Ficha de salud y atención médica del niño.",
      "columns": [
        { "name": "record_id", "type": "bigint", "key": "PK", "description": "Identificador único de la ficha" },
        { "name": "child_id", "type": "bigint", "key": "FK", "references": "children", "description": "Niño al que pertenece la ficha" },
        { "name": "eps", "type": "text", "description": "EPS a la que está afiliado" },
        { "name": "state", "type": "text", "description": "Estado de la afiliación" },
        { "name": "ips_assigned", "type": "text", "description": "IPS asignada" },
        { "name": "allergies", "type": "text", "description": "Alergias conocidas" },
        { "name": "meal_restrictions", "type": "text", "description": "Restricciones alimentarias" },
        { "name": "medicines", "type": "text", "description": "Medicamentos que toma el niño" },
        { "name": "special_conditions", "type": "text", "description": "Condiciones especiales de salud" }
      ]
    },
    {
      "name": "staff",
      "description": "Personal que trabaja en la fundación.",
      "columns": [
        { "name": "staff_id", "type": "bigint", "key": "PK", "description": "Identificador único del colaborador" },
        { "name": "full_name", "type": "text", "description": "Nombre completo" },
        { "name": "document_type_id", "type": "smallint", "description": "Tipo de documento de identidad" },
        { "name": "document_number", "type": "text", "description": "Número de documento de identidad" },
        { "name": "role_id", "type": "smallint", "description": "Cargo o rol dentro de la fundación" },
        { "name": "hire_date", "type": "date", "description": "Fecha de vinculación" },
        { "name": "exit_date", "type": "date", "description": "Fecha de desvinculación" },
        { "name": "contract_type_id", "type": "smallint", "description": "Tipo de contrato" },
        { "name": "status_id", "type": "smallint", "description": "Estado laboral actual" },
        { "name": "phone", "type": "text", "description": "Teléfono de contacto" },
        { "name": "email", "type": "text", "description": "Correo electrónico" },
        { "name": "hours_worked", "type": "numeric", "description": "Horas trabajadas" },
        { "name": "hours_payed", "type": "numeric", "description": "Horas pagadas totales" }
      ]
    },
    {
      "name": "workshops",
      "description": "Catálogo de talleres que ofrece la fundación.",
      "columns": [
        { "name": "workshop_id", "type": "bigint", "key": "PK", "description": "Identificador único del taller" },
        { "name": "name", "type": "text", "description": "Nombre del taller" },
        { "name": "duration_minutes", "type": "integer", "description": "Duración en minutos" },
        { "name": "description", "type": "text", "description": "Descripción del taller" },
        { "name": "workshop_supplies", "type": "text", "description": "Materiales necesarios" }
      ]
    },
    {
      "name": "tuition",
      "description": "Pagos de cuota o pensión asociados a cada niño.",
      "columns": [
        { "name": "tuition_fee_id", "type": "bigint", "key": "PK", "description": "Identificador único del pago" },
        { "name": "child_id", "type": "bigint", "key": "FK", "references": "children", "description": "Niño al que corresponde el pago" },
        { "name": "amount", "type": "bigint", "description": "Valor del pago" },
        { "name": "paid_date", "type": "date", "description": "Fecha de pago" },
        { "name": "payment_method", "type": "text", "description": "Medio de pago utilizado" },
        { "name": "status", "type": "text", "description": "Estado del pago" }
      ]
    }
  ],
  "relationships": [
    { "from": "guardians", "to": "children_guardians", "type": "1:N", "description": "Un acudiente puede estar vinculado a varios niños" },
    { "from": "children", "to": "children_guardians", "type": "1:N", "description": "Un niño puede tener varios acudientes" },
    { "from": "children", "to": "child_records", "type": "1:N", "description": "Un niño puede tener varias fichas de salud" },
    { "from": "staff", "to": "professionals", "type": "1:1", "description": "Un colaborador puede ser profesional" },
    { "from": "workshops", "to": "professionals_workshops", "type": "1:N", "description": "Un taller puede programarse varias veces" }
  ]
}